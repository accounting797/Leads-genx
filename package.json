{
  "name": "leads-genx",
  "version": "1.0.0",
  "description": "Production-grade local lead generation operator app.",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "npm run build && node scripts/start-dev.cjs",
    "dev:watch": "nodemon --exec ts-node src/server.ts",
    "prebuild": "node scripts/ensure-prisma-client.cjs",
    "build": "tsc",
    "start": "node dist/server.js",
    "scraper:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-google-scraper.ps1",
    "scraper:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-google-scraper.ps1",
    "scraper:down": "docker compose -f docker-compose.google-scraper.yml down",
    "pretest": "node scripts/ensure-prisma-client.cjs",
    "test": "vitest run --exclude \"**/.worktrees/**\" --maxWorkers=1 --minWorkers=1",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "apify-client": "^2.23.4",
    "csv-parse": "^7.0.2",
    "express": "^5.2.1",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.2.108",
    "socks": "^2.8.9",
    "ssh2": "^1.17.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/ssh2": "^1.15.5",
    "@types/supertest": "^6.0.3",
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
